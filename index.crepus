div wrap
  aside sidebar
    div sb-top
      a sidebar-icon href="https://crepuscularity.dev" target="_blank" rel="noopener"
        svg viewBox="0 0 32 32" fill="none"
          defs
            linearGradient id="b" x1="6" y1="28" x2="26" y2="4"
              stop stop-color="#ffb070"
              stop offset="0.45" stop-color="#e8c4ff"
              stop offset="1" stop-color="#38bdf8"
          circle cx="16" cy="16" r="14" fill="url(#b)" opacity="0.95"
          circle cx="16" cy="16" r="7" fill="#030712" opacity="0.35"
      .sb-divider
      button sidebar-icon @click="on_page_new_tab" title="New tab (⌘T)"
        svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          line x1="12" y1="5" x2="12" y2="19"
          line x1="5" y1="12" x2="19" y2="12"
      button sidebar-icon @click="on_export_md" title="Export markdown"
        svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
          polyline points="17 8 12 3 7 8"
          line x1="12" y1="3" x2="12" y2="15"
      .sb-divider
      button sidebar-icon @click="on_toggle_help" title="Help (F1)"
        svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          circle cx="12" cy="12" r="10"
          path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"
          line x1="12" y1="17" x2="12.01" y2="17"
    div sidebar-footer
      span sb-stat id="word-count"
        "0"
      span sb-stat id="char-count"
        "0"

  div editor-area
    embed editor adapter="rust"

  if {show_help}
    div help-panel
      div help-head
        div
          h2
            "Keyboard Shortcuts & Help"
        button help-close @click="on_toggle_help"
          svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"
            line x1="18" y1="6" x2="6" y2="18"
            line x1="6" y1="6" x2="18" y2="18"
      div help-grid
        div help-section
          h3
            "Tab Management"
          dl
            div
              dt "⌘T"
              dd "New tab"
            div
              dt "⌘W"
              dd "Close active tab"
            div
              dt "F1"
              dd "Toggle help panel"
            div
              dt "⌘K"
              dd "Search across tabs"

  if {show_search}
    div search-backdrop @click="on_close_search"
    div search-panel
      input search-input type="search" id="search-input" placeholder="Search tabs..."

.class-editor { flex:1; display:flex; flex-direction:column; overflow:hidden; min-width:0 }
.class-editor .tab-bar { display:flex; align-items:stretch; flex-shrink:0; overflow:hidden; height:2.25rem; background:var(--cp-elevated); border-bottom:1px solid var(--cp-border) }
.class-editor .tab-list { display:flex; align-items:stretch; overflow-x:auto; flex:1; scrollbar-width:none }
.class-editor .tab { display:flex; align-items:stretch; flex-shrink:0; position:relative; max-width:180px; min-width:80px; border-right:1px solid var(--cp-border) }
.class-editor .tab.active { background:var(--cp-bg) }
.class-editor .tab.active::after { content:""; position:absolute; bottom:0; left:0; right:0; height:2px; background:var(--cp-accent) }
.class-editor .tab-btn { flex:1; text-align:left; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; border:none; background:transparent; cursor:pointer; padding:0 0.3rem 0 0.7rem; font-size:0.78rem; color:var(--cp-muted); font-family:"Inter",system-ui,sans-serif }
.class-editor .tab.active .tab-btn { color:var(--cp-fg) }
.class-editor .tab-close { display:flex; align-items:center; justify-content:center; flex-shrink:0; border:none; background:transparent; cursor:pointer; width:1.5rem; color:var(--cp-muted); border-radius:0.2rem; margin:0.25rem 0.2rem; font-size:0.75rem }
.class-editor .tab-close:hover { color:var(--cp-fg); background:color-mix(in srgb,var(--cp-bg) 88%,white 12%) }
.class-editor .tab-new { display:flex; align-items:center; justify-content:center; flex-shrink:0; border:none; background:transparent; cursor:pointer; width:2.25rem; color:var(--cp-muted); border-left:1px solid var(--cp-border) }
.class-editor .tab-new:hover { color:var(--cp-fg); background:color-mix(in srgb,var(--cp-bg) 88%,white 12%) }
.class-editor .editor-wrap { position:relative; flex:1; min-height:0; overflow-y:auto }
.class-editor .editor-wrap::-webkit-scrollbar { width:0; height:0 }
.class-editor .editable { min-height:100%; max-width:48rem; margin:0 auto; padding:3rem 2rem 12rem; font-size:1rem; line-height:1.7; color:var(--cp-fg); caret-color:var(--cp-accent); outline:none; word-wrap:break-word; font-family:"Inter",system-ui,-apple-system,sans-serif }
.class-editor .editable:empty::before { content:attr(data-placeholder); color:var(--cp-muted); pointer-events:none; font-style:italic; position:absolute; top:3rem; left:2rem }
