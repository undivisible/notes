div class-editor @keydown="on_keydown"
  div tab-bar
    div tab-list
      for tab in {tabs}
        div tab class:active={active} data-tab-id={id}
          button tab-btn data-tab-id={id} @click="on_select_tab"
            "{title}"
          button tab-close data-tab-id={id} @click="on_close_tab"
            "×"
    button tab-new @click="on_new_tab"
      svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"
        line x1="12" y1="5" x2="12" y2="19"
        line x1="5" y1="12" x2="19" y2="12"
  div editor-wrap
    div editable contenteditable="true" data-placeholder="Start typing..." @input="on_editor_input"
      {=active_content}
    if {empty}
      div style="position:absolute;top:3rem;left:2rem;color:var(--cp-muted);font-style:italic;pointer-events:none"
        "Start typing... or press Cmd+T for a new tab"

